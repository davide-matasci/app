# Copy to .env and replace every value marked CHANGE.
# Generate each secret with:  openssl rand -hex 32
# Never commit the real .env. Keep comments on their own lines (no comments
# after a value).

###########
# DOMAINS #
###########

# CHANGE: where the sync server is reached (no https://).
SYNC_DOMAIN=sync.example.com
# CHANGE: where attachments are uploaded/downloaded (no https://).
FILES_DOMAIN=files.example.com
# CHANGE: same as FILES_DOMAIN, with https://.
PUBLIC_FILES_SERVER_URL=https://files.example.com

# CHANGE: the web app address(es) allowed to use this server, comma-separated,
# with https:// and no trailing slash. localhost and the iOS/desktop apps are
# always allowed.
CORS_ALLOWED_ORIGINS=https://notes.example.com
CORS_ORIGIN_STRICT_MODE_ENABLED=true

# CHANGE: sign-in cookie domain, the same as SYNC_DOMAIN.
COOKIE_DOMAIN=sync.example.com

######
# DB #
######

DB_HOST=db
DB_PORT=3306
DB_USERNAME=std_notes_user
# CHANGE (secret)
DB_PASSWORD=
# CHANGE (secret)
DB_ROOT_PASSWORD=
DB_DATABASE=standard_notes_db
DB_TYPE=mysql

#########
# CACHE #
#########

REDIS_PORT=6379
REDIS_HOST=cache
CACHE_TYPE=redis

########
# KEYS #
########

# CHANGE: all four (secrets, 64 hex characters each).
AUTH_JWT_SECRET=
AUTH_SERVER_ENCRYPTION_SERVER_KEY=
AUTH_SERVER_ADMIN_KEY=
VALET_TOKEN_SECRET=

################
# REGISTRATION #
################

# Set to true after you have created your own account, so nobody else can
# register on your server, then run: docker compose up -d
AUTH_SERVER_DISABLE_USER_REGISTRATION=false

#########
# IMAGE #
#########

# Pin a specific standardnotes/server tag once things work, so updates happen
# only when you choose.
SERVER_IMAGE_TAG=latest
